,[2,1115]],["postTweet",[1,1116]],["postTweet",[2,1117]],["postTweet",[1,1118]],["postTweet",[2,1119]],["postTweet",[1,1120]],["postTweet",[2,1121]],["postTweet",[1,1122]],["postTweet",[2,1123]],["postTweet",[1,1124]],["postTweet",[2,1125]],["postTweet",[1,1126]],["postTweet",[2,1127]],["postTweet",[1,1128]],["postTweet",[2,1129]],["postTweet",[1,1130]],["postTweet",[2,1131]],["postTweet",[1,1132]],["postTweet",[2,1133]],["postTweet",[1,1134]],["postTweet",[2,1135]],["postTweet",[1,1136]],["postTweet",[2,1137]],["postTweet",[1,1138]],["postTweet",[2,1139]],["postTweet",[1,1140]],["postTweet",[2,1141]],["postTweet",[1,1142]],["postTweet",[2,1143]],["postTweet",[1,1144]],["postTweet",[2,1145]],["postTweet",[1,1146]],["postTweet",[2,1147]],["postTweet",[1,1148]],["postTweet",[2,1149]],["postTweet",[1,1150]],["postTweet",[2,1151]],["postTweet",[1,1152]],["postTweet",[2,1153]],["postTweet",[1,1154]],["postTweet",[2,1155]],["postTweet",[1,1156]],["postTweet",[2,1157]],["postTweet",[1,1158]],["postTweet",[2,1159]],["postTweet",[1,1160]],["postTweet",[2,1161]],["postTweet",[1,1162]],["postTweet",[2,1163]],["postTweet",[1,1164]],["postTweet",[2,1165]],["postTweet",[1,1166]],["postTweet",[2,1167]],["postTweet",[1,1168]],["postTweet",[2,1169]],["postTweet",[1,1170]],["postTweet",[2,1171]],["postTweet",[1,1172]],["postTweet",[2,1173]],["postTweet",[1,1174]],["postTweet",[2,1175]],["postTweet",[1,1176]],["postTweet",[2,1177]],["postTweet",[1,1178]],["postTweet",[2,1179]],["postTweet",[1,1180]],["postTweet",[2,1181]],["postTweet",[1,1182]],["postTweet",[2,1183]],["postTweet",[1,1184]],["postTweet",[2,1185]],["postTweet",[1,1186]],["postTweet",[2,1187]],["postTweet",[1,1188]],["postTweet",[2,1189]],["postTweet",[1,1190]],["postTweet",[2,1191]],["postTweet",[1,1192]],["postTweet",[2,1193]],["postTweet",[1,1194]],["postTweet",[2,1195]],["postTweet",[1,1196]],["postTweet",[2,1197]],["postTweet",[1,1198]],["postTweet",[2,1199]],["getNewsFeed",[1]],["getNewsFeed",[3]],["follow",[3,1]],["follow",[3,2]],["getNewsFeed",[3]]]},"output":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[200,199,198,197,196,195,194,193,192,191],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[250,249,248,247,246,245,244,243,242,241],[250,249,248,247,246,245,244,243,242,241],null,[200,199,198,197,196,195,194,193,192,191],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[1198,1196,1194,1192,1190,1188,1186,1184,1182,1180],[],null,null,[1199,1198,1197,1196,1195,1194,1193,1192,1191,1190]]}],"solution":"class Twitter:\n    FEED_SIZE = 10\n\n    def __init__(self):\n        self.clock = 0\n        self.tweets = defaultdict(list)     # userId -> [(time, tweetId)], oldest first\n        self.following = defaultdict(set)   # userId -> set of followee ids\n\n    def postTweet(self, userId: int, tweetId: int) -> None:\n        self.tweets[userId].append((self.clock, tweetId))\n        self.clock += 1\n\n    def getNewsFeed(self, userId: int) -> List[int]:\n        heap = []\n        for uid in self.following[userId] | {userId}:\n            posts = self.tweets[uid]\n            if posts:\n                t, tid = posts[-1]\n                heap.append((-t, tid, uid, len(posts) - 1))\n        heapify(heap)\n        feed = []\n        while heap and len(feed) < self.FEED_SIZE:\n            _, tid, uid, idx = heappop(heap)\n            feed.append(tid)\n            if idx > 0:\n                t, nxt = self.tweets[uid][idx - 1]\n                heappush(heap, (-t, nxt, uid, idx - 1))\n        return feed\n\n    def follow(self, followerId: int, followeeId: int) -> None:\n        if followerId != followeeId:\n            self.following[followerId].add(followeeId)\n\n    def unfollow(self, followerId: int, followeeId: int) -> None:\n        self.following[followerId].discard(followeeId)\n","approach":"**Key insight: a news feed is a k-way merge of already-sorted per-user timelines.** Each user's tweets are appended in time order, so the newest tweet of each followee is at the end of their list. A max-heap seeded with one entry per followee lets you pull the globally newest tweet, then push that user's next-newest, exactly like merging k sorted lists. Because the feed stops after 10 items, at most 10 pops happen.\n\nA global counter gives tweets a total order (wall-clock time can collide). `following` is a set per user so follow and unfollow are O(1) and duplicates are impossible. Guarding `follow(u, u)` prevents a user appearing twice in the merge; the solution unions `{userId}` in at read time so users always see their own posts.\n\n**Common mistakes:** returning oldest first; letting a self-follow cause duplicate tweets in the feed; scanning and sorting *all* tweets of all followees on every feed call, which is O(total tweets log total) instead of O(k + 10 log k); unfollow raising on a missing followee (use `discard`).\n\n**Interview follow-ups:** Fan-out on write vs fan-out on read: for users with millions of followers, precomputing feeds (pushing each tweet into followers' feed caches) explodes; real systems mix both, pushing for normal users and pulling for celebrities. How would you cap memory? (keep only the last N tweets per user in the hot store.) Pagination: pass the timestamp of the last item seen and merge from there.","complexity":{"time":"O(1) post/follow/unfollow; O(k + 10 log k) per feed where k is the number of followees","space":"O(tweets + follow edges)"},"similar":["merge-k-sorted-lists","lru-cache"],"number":176}