7.2],[2.7,8.9],[5.8,0.6],[8.9,2.3],[2.0,4.0],[5.1,5.7],[8.2,7.4],[1.3,9.1],[4.4,0.8],[7.5,2.5],[0.6,4.2],[3.7,5.9],[6.8,7.6],[9.9,9.3],[3.0,1.0],[6.1,2.7],[9.2,4.4],[2.3,6.1],[5.4,7.8],[8.5,9.5],[1.6,1.2],[4.7,2.9],[7.8,4.6],[0.9,6.3],[4.0,8.0],[7.1,9.7],[0.2,1.4],[3.3,3.1],[6.4,4.8],[9.5,6.5],[2.6,8.2],[5.7,9.9],[8.8,1.6],[1.9,3.3],[5.0,5.0],[8.1,6.7],[1.2,8.4],[4.3,0.1],[7.4,1.8],[0.5,3.5],[3.6,5.2],[6.7,6.9],[9.8,8.6],[2.9,0.3],[6.0,2.0],[9.1,3.7],[2.2,5.4],[5.3,7.1],[8.4,8.8],[1.5,0.5],[4.6,2.2],[7.7,3.9],[0.8,5.6],[3.9,7.3],[7.0,9.0],[0.1,0.7],[3.2,2.4],[6.3,4.1],[9.4,5.8],[2.5,7.5],[5.6,9.2],[8.7,0.9],[1.8,2.6],[4.9,4.3],[8.0,6.0],[1.1,7.7],[4.2,9.4],[7.3,1.1],[0.4,2.8],[3.5,4.5],[6.6,6.2],[9.7,7.9],[2.8,9.6],[5.9,1.3],[9.0,3.0],[2.1,4.7],[5.2,6.4],[8.3,8.1],[1.4,9.8],[4.5,1.5],[7.6,3.2],[0.7,4.9],[3.8,6.6],[6.9,8.3]],"centroids":[[0,0],[10,0],[0,10],[10,10]]},"output":[[2.5,2.5],[7.5,2.5],[2.5,7.5],[7.5,7.5]]}],"solution":"class Solution:\n    def kmeansStep(self, points: List[List[float]], centroids: List[List[float]]) -> List[List[float]]:\n        k = len(centroids)\n        d = len(centroids[0])\n        sums = [[0.0] * d for _ in range(k)]\n        counts = [0] * k\n        for p in points:\n            best, best_d2 = 0, float('inf')\n            for j, c in enumerate(centroids):\n                d2 = 0.0\n                for a, b in zip(p, c):\n                    d2 += (a - b) * (a - b)\n                if d2 < best_d2:\n                    best, best_d2 = j, d2\n            counts[best] += 1\n            for i in range(d):\n                sums[best][i] += p[i]\n        new_centroids = []\n        for j in range(k):\n            if counts[j] == 0:\n                new_centroids.append([float(v) for v in centroids[j]])\n            else:\n                new_centroids.append([s / counts[j] for s in sums[j]])\n        return new_centroids\n","approach":"**Lloyd's algorithm alternates two exact minimisations of the within-cluster sum of squares.** Holding the centroids fixed, assigning every point to its nearest centroid minimises the objective; holding the assignments fixed, the mean of each cluster is the point that minimises the summed squared distance. Each step therefore never increases the objective, which is why k-means converges (to a local optimum).\n\nImplementation notes: compare squared distances to avoid `sqrt`; use a strict `<` while scanning centroids in order so ties resolve to the lowest index; keep running sums and counts rather than building lists of members. The empty-cluster rule (keep the old position) is one common convention; others re-seed the centroid at the farthest point.\n\n**Interview follow-ups:** How do you initialise? (random points, or k-means++ which picks seeds with probability proportional to squared distance from existing seeds, giving an O(log k) approximation guarantee). How do you decide convergence and choose k? (centroid shift below a tolerance or assignments unchanged; elbow or silhouette for k). Why does k-means struggle with non-spherical clusters or features on different scales? What is the per-iteration complexity and how would you speed it up for large n? (O(n k d); mini-batch k-means, triangle-inequality pruning, KD-trees in low dimension).","complexity":{"time":"O(n * k * d)","space":"O(k * d)"},"similar":["knn-classify","pca-power-iteration"],"number":205,"starter":"class Solution:\n    def kmeansStep(self, points: List[List[float]], centroids: List[List[float]]) -> List[List[float]]:\n        pass\n"}